# CAN interface
TM3_CHANNEL=can0
TM3_INTERFACE=socketcan
# TM3_BITRATE=500000

# Squashfs-root of a Tesla firmware extraction.
# nodes.json, ETH compact, ODJ dir, and seed artifacts are all derived from this.
# TM3_ROOT=/path/to/squashfs-root

# Odin .bin decryption key for Model3_ETH.compact.json(.bin) and ODJ .bin files.
# Found in: opt/odin/odin from a firmware squashfs extraction.
# Extract with pyinstxtractor + xdis, look for constant C in
# odin/platforms/binary_metadata_utils.py (STORE_NAME C instruction).
# TM3_BIN_KEY=<base64-encoded value>
